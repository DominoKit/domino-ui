<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.dominokit</groupId>
        <artifactId>domino-ui-parent</artifactId>
        <version>HEAD-SNAPSHOT</version>
    </parent>

    <artifactId>domino-ui</artifactId>
    <packaging>gwt-lib</packaging>

    <name>domino-ui</name>
    <properties>
        <domino-slf4j-logger.version>2.0.1</domino-slf4j-logger.version>
        <slf4j-api.version>2.0.16</slf4j-api.version>
        <maven.antrun.plugin>3.1.0</maven.antrun.plugin>
        <maven.resources.plugin>3.3.1</maven.resources.plugin>
        <maven.surefire.plugin>3.2.5</maven.surefire.plugin>
        <ph.csscompress.maven.plugin>7.1.0</ph.csscompress.maven.plugin>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm-commons</artifactId>
                <version>9.7.1</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm</artifactId>
                <version>9.7.1</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm-util</artifactId>
                <version>9.7.1</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm-tree</artifactId>
                <version>9.7.1</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm-analysis</artifactId>
                <version>9.7.1</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>2.14.0</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>3.18.0</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>com.google.jsinterop</groupId>
                <artifactId>jsinterop-annotations</artifactId>
                <version>2.0.2</version>
            </dependency>
            <dependency>
                <groupId>com.google.code.findbugs</groupId>
                <artifactId>jsr305</artifactId>
                <version>3.0.2</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.dominokit</groupId>
            <artifactId>domino-ui-shared</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.dominokit</groupId>
            <artifactId>gwt-validation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.gwtproject.core</groupId>
            <artifactId>gwt-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.gwtproject.editor</groupId>
            <artifactId>gwt-editor</artifactId>
        </dependency>
        <dependency>
            <groupId>org.gwtproject.timer</groupId>
            <artifactId>gwt-timer</artifactId>
        </dependency>
        <dependency>
            <groupId>org.gwtproject.safehtml</groupId>
            <artifactId>gwt-safehtml</artifactId>
        </dependency>
        <dependency>
            <groupId>org.dominokit.i18n</groupId>
            <artifactId>gwt-datetimeformat</artifactId>
        </dependency>
        <dependency>
            <groupId>org.dominokit.i18n</groupId>
            <artifactId>gwt-numberformat</artifactId>
        </dependency>

        <dependency>
            <groupId>com.google.elemental2</groupId>
            <artifactId>elemental2-svg</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.elemental2</groupId>
            <artifactId>elemental2-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.elemental2</groupId>
            <artifactId>elemental2-dom</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.elemental2</groupId>
            <artifactId>elemental2-webstorage</artifactId>
        </dependency>
        <dependency>
            <groupId>org.gwtproject</groupId>
            <artifactId>gwt-dev</artifactId>
            <version>${gwt.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.gwtproject</groupId>
            <artifactId>gwt-user</artifactId>
            <version>${gwt.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.dominokit</groupId>
            <artifactId>mdi-icons-processor</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.dominokit</groupId>
            <artifactId>domino-slf4j-logger</artifactId>
            <version>${domino-slf4j-logger.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j-api.version}</version>
        </dependency>
        <dependency>
            <groupId>org.dominokit</groupId>
            <artifactId>domino-doc-tool</artifactId>
            <version>${domino.doc.tool.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <excludes>
                    <exclude>/cached/**/*.*</exclude>
                    <exclude>**/fonts/**/*.*</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <includes>
                    <include>**/fonts/**/*.*</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>net.ltgt.gwt.maven</groupId>
                <artifactId>gwt-maven-plugin</artifactId>
                <configuration>
                    <moduleName>org.dominokit.domino.ui.DominoUI</moduleName>
                </configuration>
            </plugin>

            <plugin>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>${maven.antrun.plugin}</version>
                <executions>
                    <execution>
                        <id>prepare-css-minification</id>
                        <phase>process-test-classes</phase>
                        <configuration>
                            <target>
                                <delete file="${project.build.outputDirectory}/org/dominokit/domino/ui/public/css/domino-ui/dui-components/domino-ui-waitMe.css"/>
                                <delete file="${project.build.outputDirectory}/org/dominokit/domino/ui/public/css/domino-ui/dui-components/domino-ui-waitMe.min.css"/>
                                <concat destfile="${project.build.outputDirectory}/org/dominokit/domino/ui/public/css/domino-ui/domino-ui.css"
                                        encoding="UTF-8" fixlastline="true">
                                    <sort>
                                        <fileset dir="${project.build.outputDirectory}/org/dominokit/domino/ui/public/css/domino-ui/dui-components"
                                                 includes="**/*.css" excludes="**/*.min.css"/>
                                    </sort>
                                </concat>
                                <concat destfile="${project.build.outputDirectory}/org/dominokit/domino/ui/public/css/domino-ui/themes/domino-ui-themes.css"
                                        encoding="UTF-8" fixlastline="true">
                                    <sort>
                                        <fileset dir="${project.build.outputDirectory}/org/dominokit/domino/ui/public/css/domino-ui/themes"
                                                 includes="**/*.css"
                                                 excludes="domino-ui-themes.css,**/*.min.css"/>
                                    </sort>
                                </concat>
                                <concat destfile="${project.build.outputDirectory}/org/dominokit/domino/ui/public/css/domino-ui/domino-ui-css-all.css"
                                        encoding="UTF-8" fixlastline="true">
                                    <filelist dir="${project.build.outputDirectory}/org/dominokit/domino/ui/public/css/domino-ui"
                                              files="domino-ui.css,themes/domino-ui-themes.css,domino-ui-fonts-modern.css"/>
                                </concat>

                                <delete dir="${project.build.directory}/css-minification-input"/>
                                <delete dir="${project.build.directory}/css-minification-output"/>
                                <mkdir dir="${project.build.directory}/css-minification-input"/>
                                <copy todir="${project.build.directory}/css-minification-input">
                                    <fileset dir="${project.build.outputDirectory}/org/dominokit/domino/ui/public/css/domino-ui">
                                        <include name="domino-ui.css"/>
                                        <include name="domino-ui-css-all.css"/>
                                        <include name="domino-ui-fonts-modern.css"/>
                                        <include name="dui-components/**/domino-ui-*.css"/>
                                        <include name="themes/domino-ui-themes.css"/>
                                        <include name="themes/**/domino-ui-theme-*.css"/>
                                        <exclude name="**/*.min.css"/>
                                    </fileset>
                                </copy>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>com.helger.maven</groupId>
                <artifactId>ph-csscompress-maven-plugin</artifactId>
                <version>${ph.csscompress.maven.plugin}</version>
                <executions>
                    <execution>
                        <id>compress-domino-ui-css</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>csscompress</goal>
                        </goals>
                        <configuration>
                            <sourceDirectory>${project.build.directory}/css-minification-input</sourceDirectory>
                            <targetDirectory>${project.build.directory}/css-minification-output</targetDirectory>
                            <recursive>true</recursive>
                            <forceCompress>true</forceCompress>
                            <sourceEncoding>UTF-8</sourceEncoding>
                            <targetEncoding>UTF-8</targetEncoding>
                            <targetFileExtension>.min.css</targetFileExtension>
                            <browserCompliantMode>true</browserCompliantMode>
                            <removeUnnecessaryCode>true</removeUnnecessaryCode>
                            <writeFontFaceRules>true</writeFontFaceRules>
                            <writeKeyframesRules>true</writeKeyframesRules>
                            <writeMediaRules>true</writeMediaRules>
                            <writeSupportsRules>true</writeSupportsRules>
                            <writeUnknownRules>true</writeUnknownRules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <version>${maven.resources.plugin}</version>
                <executions>
                    <execution>
                        <id>copy-minified-css-resources</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/org/dominokit/domino/ui/public/css/domino-ui</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}/css-minification-output</directory>
                                    <filtering>false</filtering>
                                    <includes>
                                        <include>**/*.min.css</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.plugin}</version>
                <executions>
                    <execution>
                        <id>verify-minified-css-package-contract</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/CssMinificationPackageContract.java</include>
                            </includes>
                            <failIfNoTests>true</failIfNoTests>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
